# Copia este archivo a .env y rellena los valores
# cp .env.example .env

# API key de Google Gemini (obligatoria)
# Consíguela en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_api_key_aqui

# Modelo Gemini a usar (opcional — por defecto gemini-2.5-flash)
# Fallback automático: gemini-2.5-flash → gemini-2.0-flash → gemini-2.0-flash-lite
GEMINI_MODEL=gemini-2.5-flash

# Rutas de datos (no tocar salvo que muevas los archivos)
DATA_FILE=data/offers.json
CV_FILE=data/cv.txt
